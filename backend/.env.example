NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://repo_health:repo_health@localhost:5432/repo_health?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
FRONTEND_URL=http://localhost:3001
# Generate locally; never reuse or commit this value.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
SOURCECRAFT_API_BASE_URL=https://api.sourcecraft.tech
SOURCECRAFT_TOKEN=
# Optional path to a recent SourceCraft CLI with `src appsec defect list` support.
# When omitted, Security is marked NO_DATA and excluded from Repo Health Score.
SOURCECRAFT_CLI_PATH=
# Safety limit for one SourceCraft-wide public-catalog refresh (100 repositories per page).
SOURCECRAFT_CATALOG_MAX_PAGES=100
SCHEDULE_ENABLED=true
ANALYSIS_INTERVAL_HOURS=24

# Optional until Yandex login is enabled. CLIENT_ID and CLIENT_SECRET are a pair.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:3000/api/auth/yandex/callback
